# WCE Bot - environment configuration
# WCE Bot - Environment Configuration
# Copy this file to .env and fill in the values. Never commit .env.
# ----

# ---- LLM API Keys ----
# Get free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get free Groq key: https://console.groq.com/keys
GROQ_API_KEY=

# ---- Redis ----
# Local Redis URL. Default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ---- Scraper ----
# The college website to crawl. Replace with the real URL when ready.
BASE_URL=https://your-college-website.edu

# How many link-hops deep to crawl (1 = BASE_URL page + its links; 2 = + links-of-links; ...)
MAX_CRAWL_DEPTH=3

# Safety cap: stop the crawl after this many documents (0 = unlimited).
MAX_PAGES=20000

# Custom CA bundle (PEM) for scraping. Leave empty to use certifi defaults.
# Set this if the target site serves its certificate without the intermediate.
SSL_CA_BUNDLE=

# ---- Storage Paths ----
CHROMA_PATH=./data/chroma_db
PDF_DOWNLOAD_PATH=./data/pdfs

# ---- Retrieval Settings ----
# Minimum cosine similarity score to trigger LLM (0.0-1.0). Tune after testing.
SIMILARITY_THRESHOLD=0.35

# Number of chunks to retrieve per query
TOP_K=6

# ---- Rate Limiting ----
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Cache ----
# How long to cache responses in Redis (seconds). Default: 24 hours
CACHE_TTL_SECONDS=86400

# ---- Input Validation ----
MAX_QUERY_LENGTH=500

# ---- CORS ----
# Comma-separated list of allowed origins for the browser frontend.
# "null" is required when opening frontend/index.html directly as a file:// URL.
ALLOWED_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:8000,null

# ---- Fallback / Branding ----
# Shown to users when no relevant content is found
OFFICIAL_SITE_FALLBACK_URL=https://your-college-website.edu

# ---- Social media ----
# YouTube channel ID (starts with "UC") for the keyless RSS feed integration.
# Find it on the channel page -> right-click -> View Page Source -> search
# "channelId", or use the youtube.com/channel/UC... URL.
# Leave empty to disable live YouTube context (static social links still work).
YOUTUBE_CHANNEL_ID=UCkWEgeBCY5U6sl7jS9YShwA

# ---- Floating widget / demo proxy ----
# Origin used in the embed snippet: <script src="<WIDGET_API_BASE>/widget.js">
WIDGET_API_BASE=http://localhost:8000
# Port for scripts/demo_proxy.py - the local college-site mirror that injects
# the floating chat button.
DEMO_PROXY_PORT=9000
